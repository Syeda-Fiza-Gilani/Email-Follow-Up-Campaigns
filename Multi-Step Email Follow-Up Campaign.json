    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function extractPlaceholders(str) {\n    // Matches {placeholder} tokens (alphanumeric, dash, underscore)\n    const regex = /\\{([a-zA-Z0-9_-]+)\\}/g;\n    const uniquePlaceholders = new Set();\n    let match;\n    while ((match = regex.exec(str)) !== null) {\n        uniquePlaceholders.add(match[1]);\n    }\n    return Array.from(uniquePlaceholders);\n}\n\nconst available = Object.keys(item.json.placeholders);\n\n// Substitute every placeholder in the message template\nitem.json.message = item.json.message_template;\nfor (const key of extractPlaceholders(item.json.message_template)) {\n  if (!available.includes(key)) throw new Error(`Missing data for placeholder '{${key}}'`);\n  const regex = new RegExp(`\\\\{${key}\\\\}`, 'g');\n  item.json.message = item.json.message.replaceAll(regex, item.json.placeholders[key]);\n}\n\nreturn item;"
      },
