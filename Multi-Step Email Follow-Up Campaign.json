      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function extractPlaceholders(str) {\n    // Matches {placeholder} tokens (alphanumeric, dash, underscore)\n    const regex = /\\{([a-zA-Z0-9_-]+)\\}/g;\n    const uniquePlaceholders = new Set();\n    let match;\n    while ((match = regex.exec(str)) !== null) {\n        uniquePlaceholders.add(match[1]);\n    }\n    return Array.from(uniquePlaceholders);\n}\n\n// Gather all placeholder values from every template in the sequence\nconst allRaw = $('Email sequence').first().json.emails.flatMap(e => extractPlaceholders(e.message));\nconst all = [...new Set(allRaw)];\nconst placeholders = {};\nfor (const ph of all) {\n  if ($('Get emails').item.json[ph] == undefined) {\n    throw new Error(`Message placeholder '{${ph}}' requires a column called '${ph}' in the Google Sheet`);\n  }\n  placeholders[ph] = $('Get emails').item.json[ph];\n}\n\nitem.json.placeholders = placeholders;\n\nreturn item;"
      },
