        "jsCode": "// TODO: some messages have an empty payload and a `parts` array instead (multipart)\n\nfor (const item of $input.all()) {\n  for (const message of item.json.messages) {\n    const buffer = Buffer.from(message.payload.body.data || \"\", \"base64\");\n    message.html = buffer.toString(\"utf8\");\n  }\n}\n\nreturn $input.all();"
      },
